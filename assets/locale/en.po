#: src/tavern/tavern_interactions.gd
msgid "Отойдите от створки · {interact} — повернуть дверь"
msgstr "Step away from the door leaf · {interact} — turn the door"

#: src/tavern/tavern_interactions.gd
msgid "{interact} — закрыть · %s"
msgstr "{interact} — close · %s"

#: src/tavern/tavern_interactions.gd

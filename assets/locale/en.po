msgstr "Ladder to the loft"

#: src/tavern/tavern_interactions.gd
msgid "{interact} — встать   ·   {look} — обзор"
msgstr "{interact} — stand up   ·   {look} — look around"

#: src/tavern/tavern_interactions.gd

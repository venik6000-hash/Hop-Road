msgid "Скорость взгляда стиком, градусов в секунду"
msgstr "Stick look speed, degrees per second"

#: src/settings/settings_panel.gd
msgid "Мёртвая зона стиков"
msgstr "Stick dead zone"

#: src/settings/settings_panel.gd
msgid "Сбросить управление"
msgstr "Reset controls"

#: src/settings/settings_panel.gd
msgid "«%s» — единственная привязка действия «%s». Сначала дайте ему другую."
msgstr "“%s” is the only binding of the action “%s”. Give it another one first."

#: src/settings/settings_panel.gd

[gd_resource type="Resource" script_class="RegionDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/world/region_def.gd" id="1_region"]
[ext_resource type="Script" path="res://src/world/region_spawn.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://assets/regions/valley/environment.tres" id="3_environment"]

[sub_resource type="Resource" id="Resource_tavern"]
script = ExtResource("2_spawn")
id = &"tavern"
position = Vector3(0, 12, 15)
yaw_deg = -30.0
pitch_deg = 10.0

[sub_resource type="Resource" id="Resource_beach"]
script = ExtResource("2_spawn")
id = &"beach"
position = Vector3(-58, 4, -6)
yaw_deg = 20.0
pitch_deg = -4.0

[resource]
script = ExtResource("1_region")
id = &"valley"
title = "Долина таверны"
bounds = Rect2(-9000, -9700, 16376, 16376)
parts = Array[StringName]([&"falls", &"brook", &"tavern", &"cottages", &"buildings", &"village_pack", &"rocks", &"vegetation", &"flora", &"people", &"camping", &"wildlife", &"dragon", &"lakeside"])

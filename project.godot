; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Хмельная тропа"
config/description="Расслабляющая прогулка по фэнтезийной долине"
run/main_scene="res://scenes/alpine/loading.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EditorSessionGuard="*res://src/core/editor_session_guard.gd"
GameSettings="*res://src/settings/game_settings.gd"
InputActions="*res://src/core/input_actions.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=2400
window/size/window_height_override=1350
window/size/window_width_override.movie=1920
window/size/window_height_override.movie=1080
window/stretch/mode="canvas_items"

[editor]

movie_writer/mjpeg_quality=0.95

[editor_plugins]

enabled=PackedStringArray("res://addons/vegetation_cache_export/plugin.cfg")

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=4
reflections/reflection_atlas/reflection_count=24

[shader_globals]

sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_radiance_scale={
"type": "vec3",
"value": Vector3(12.566, 12.566, 12.566)
}
atmo_transmittance={
"type": "sampler2D",
"value": ""
}
atmo_skyview={
"type": "sampler2D",
"value": ""
}
atmo_view_radius={
"type": "float",
"value": 6360.75
}
moon_direction={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
night_factor={
"type": "float",
"value": 0.0
}
cloud_params={
"type": "vec4",
"value": Vector4(0.42, 1, 0.1, 0)
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
weather_sky={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lightning_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lightning_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_displacement={
"type": "sampler2DArray",
"value": ""
}
water_derivatives={
"type": "sampler2DArray",
"value": ""
}
water_tiles={
"type": "vec4",
"value": Vector4(250, 37, 7.3, 1)
}
water_cascade_weights={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
lake_shore_state={
"type": "sampler2D",
"value": ""
}
lake_shore_region={
"type": "vec4",
"value": Vector4(-170, -150, 256, 0)
}
lake_shore_clock={
"type": "vec2",
"value": Vector2(0, 0)
}
sun_shadow_near={
"type": "sampler2D",
"value": ""
}
sun_shadow_far={
"type": "sampler2D",
"value": ""
}
sun_shadow_near_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
sun_shadow_far_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
rain_shelter={
"type": "sampler2D",
"value": ""
}
rain_shelter_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
weather_wet={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
canopy_cover={
"type": "sampler2D",
"value": ""
}
canopy_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
canopy_light={
"type": "vec2",
"value": Vector2(0.6, 0.85)
}
sun_shadow_reach={
"type": "vec2",
"value": Vector2(136, 160)
}

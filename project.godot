; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Хмельная тропа"
config/name_localized={
"en": "Hop Road"
}
config/description="Расслабляющая прогулка по фэнтезийной долине"
config/version="0.1.0"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EditorSessionGuard="*res://src/core/editor_session_guard.gd"
GameSettings="*res://src/settings/game_settings.gd"
InputActions="*res://src/core/input_actions.gd"
GameEvents="*res://src/core/game_events.gd"
SaveService="*res://src/save/save_service.gd"
GameFlow="*res://src/flow/game_flow.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/game.log"
file_logging/max_log_files=10
gdscript/warnings/directory_rules={
"res://addons": 0,
"res://src/water": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=2400
window/size/window_height_override=1350
window/size/window_width_override.movie=1920
window/size/window_height_override.movie=1080
window/stretch/mode="canvas_items"

[editor]

movie_writer/mjpeg_quality=0.95

[editor_plugins]

enabled=PackedStringArray("res://addons/vegetation_cache_export/plugin.cfg")

[importer_defaults]

texture={
"compress/high_quality": false,
"compress/mode": 2,
"mipmaps/generate": true,
"process/size_limit": 2048
}

[internationalization]

locale/translations=PackedStringArray("res://assets/locale/en.po", "res://assets/locale/ru.po")
locale/fallback="ru"

[layer_names]

3d_physics/layer_1="мир"
3d_physics/layer_2="игрок"
3d_physics/layer_3="жители"
3d_physics/layer_4="звери"
3d_physics/layer_5="валуны"
3d_physics/layer_6="переносимые предметы"
3d_physics/layer_7="кости рэгдолла"
3d_physics/layer_8="зоны"

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=4
reflections/reflection_atlas/reflection_count=24

[shader_globals]

sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_radiance_scale={
"type": "vec3",
"value": Vector3(12.566, 12.566, 12.566)
}
atmo_transmittance={
"type": "sampler2D",
"value": ""
}
atmo_skyview={
"type": "sampler2D",
"value": ""
}
atmo_view_radius={
"type": "float",
"value": 6360.75
}
moon_direction={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
night_factor={
"type": "float",
"value": 0.0
}
cloud_params={
"type": "vec4",
"value": Vector4(0.42, 1, 0.1, 0)
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
weather_sky={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lightning_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lightning_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_displacement={
"type": "sampler2DArray",
"value": ""
}
water_derivatives={
"type": "sampler2DArray",
"value": ""
}
water_tiles={
"type": "vec4",
"value": Vector4(250, 37, 7.3, 1)
}
water_cascade_weights={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
lake_shore_state={
"type": "sampler2D",
"value": ""
}
lake_shore_region={
"type": "vec4",
"value": Vector4(-170, -150, 256, 0)
}
lake_shore_clock={
"type": "vec2",
"value": Vector2(0, 0)
}
sun_shadow_near={
"type": "sampler2D",
"value": ""
}
sun_shadow_far={
"type": "sampler2D",
"value": ""
}
sun_shadow_near_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
sun_shadow_far_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
rain_shelter={
"type": "sampler2D",
"value": ""
}
rain_shelter_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
weather_wet={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
canopy_cover={
"type": "sampler2D",
"value": ""
}
canopy_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
canopy_light={
"type": "vec2",
"value": Vector2(0.6, 0.85)
}
sun_shadow_reach={
"type": "vec2",
"value": Vector2(136, 160)
}

extends RefCounted
## Чистые правила движения игрока: константы и статические функции без
## состояния узла. Player повторяет их под прежними именами.

const WALK_SPEED := 3.0
const RUN_SPEED := 5.0
const ACCELERATION := 14.0    ## м/с² — набор и сброс горизонтальной скорости
const GRAVITY := 22.0         ## сильнее реальной: падение читается бодрее

## --- вода -------------------------------------------------------------------
##
## Глубина меряется от подошвы до поверхности прямо над игроком: уровень озера
## плюс высота волны в этой точке (её ставит уровень из OceanFFT, на кадр
## позже). С колена вода тормозит шаг, с груди — держит: вместо гравитации тело
## подтягивается к плавучей высоте, где подошва на SWIM_DEPTH ниже поверхности,
## а глаза (1.6 м над подошвой) — на четверть метра выше неё. Плавучая высота
## ходит вместе с волной, поэтому пловца качает.
const WADE_DEPTH := 0.45      ## отсюда вода начинает тормозить
const SWIM_DEPTH := 1.35      ## отсюда держит на плаву
const WADE_SLOWDOWN := 0.5    ## доля сухой скорости у самой границы плавания
const SWIM_SPEED := 1.4       ## м/с, брасс
const SWIM_SPRINT := 2.2      ## м/с, кроль (Shift)
const BUOYANCY := 3.0         ## 1/с: вертикальная скорость на метр до плавучей высоты
const BUOYANCY_RESPONSE := 6.0  ## 1/с: как быстро вода гасит прежнюю вертикаль
## Под водой (голова ниже поверхности или зажат «нырнуть») плывут туда, куда
## смотрят, вместе с наклоном камеры; Пробел и C/Ctrl добавляют подъём и
## спуск. Без ввода тело с воздухом в лёгких медленно всплывает.
const EYE_HEIGHT := 1.6       ## глаза над подошвой: CameraRig в scenes/player/player.tscn
const DIVE_SPEED := 1.1       ## м/с по вертикали на Пробел / C
const DRIFT_UP := 0.35        ## м/с всплытия без ввода
const WATER_DRAG := 2.5       ## 1/с: вода вязкая, скорость подходит к желаемой за ~0.4 с

## --- перешагивание низких препятствий -------------------------------------
##
## Голый CharacterBody3D ступенек не знает вовсе. Капсула перекатывается через
## кромку, только пока нормаль касания положе floor_max_angle, а для полусферы
## радиусом 0.35 это ровно 10 см: всё, что выше, останавливает игрока намертво —
## что порожек в ладонь, что стена дома. Это уже стоило игры один раз: на стыке
## моста с насыпью стоял уступ в 31 см, и он читался невидимой стеной посреди
## единственной дороги.
##
## **Откуда 0.42 м.** Цифра зажата с двух сторон; обе границы проверяет
## tests/test_player.gd.
##
## Снизу её держат уступы, по которым игрок обязан проходить:
##
## * подступёнок каменного марша ко входу в таверну — 0.25 м. По нему обязаны
##   всходить, иначе в таверну не войти;
## * тот самый стык моста — 0.31 м;
## * запас на шов рельефа: там, где насыпь круче, чем сетка рельефа умеет
##   выразить, на стыке с чужой геометрией остаётся вертикальная кромка того же
##   порядка.
##
## Сверху её держит всё, на что всходить НЕ полагается: забор, прилавок,
## подпорная терраса — всё выше колена, от 0.5 м. Между 0.31 и 0.50 остаётся
## узкая щель, и 0.42 сидит в ней с запасом в одиннадцать сантиметров вниз и
## в восемь вверх.
##
## Заодно это правдоподобно телом: игрок ростом 1.75 м, и 0.42 — высота колена,
## то есть предел обычного шага. Выше начинается запрыгивание, а прогулочной
## игре запрыгивать не на что.
const STEP_HEIGHT := 0.42
## Уступ мельче этого шагом не считается. Пол не идеально ровен нигде — на
## гранях сетки рельефа и на выпуклой оболочке любого камня постоянно набегают
## доли миллиметра, — и без нижнего порога подъём срабатывал бы каждый кадр на
## ровном месте, дёргая камеру.
const STEP_MIN := 0.01
## Ниже этой скорости шага нет: игрок стоит, а не идёт. Спека требует шагать
## тогда, когда игрок ИДЁТ вперёд и упёрся, а не всегда.
const STEP_MIN_SPEED := 0.1
## Насколько дальше кромки щупается площадка под ногой, метров.
##
## Само касание для решения не годится и врёт систематически: капсула упирается
## в РЕБРО препятствия, а не в его поверхность, и оба замера по ребру
## получаются ложными.
##
## Нормаль там смотрит от ребра к центру сферы — под 50–70° к вертикали даже у
## идеально горизонтальной проступи, то есть любая лестница выглядела бы
## отвесной скалой.
##
## Высота ребра врёт в другую сторону, и это опаснее. Опускаясь на тумбу в 60
## см, капсула ложится на её ребро сбоку и подошва оказывается на 37 см — внутри
## окна шага. Игрок вкатывался на такую тумбу за несколько кадров: каждый из них
## поднимал его на «законные» сантиметры, а вместе они брали высоту, которую
## брать не полагается. Ровно так же он взял бы забор и любую стену, у которой
## есть верх.
##
## Поэтому и нормаль, и высота площадки читаются отдельным лучом, пущенным на
## десять сантиметров дальше кромки — уже по самой поверхности, а не по её краю.
const STEP_SURFACE_AHEAD := 0.10
## И насколько ниже кромки этот луч ещё считается попавшим в площадку. Если под
## кромкой пусто — это не ступень, а карниз над обрывом, и ступать туда некуда.
const STEP_SURFACE_BELOW := 0.10
## Прилипание к полу на спуске (floor_snap_length), метров.
##
## Штатный механизм Godot 4: после move_and_slide тело, которое было на полу и
## оторвалось от него, притягивается вниз в пределах этой длины. Без него сход
## с любой ступени превращается в свободное падение — игрок зависает в воздухе и
## падает рывком, а камера при этом клюёт.
##
## Длина не может быть меньше высоты шага: спуск обязан быть не хуже подъёма,
## иначе игрок всходит на уступ плавно, а сходит с него прыжком. Плюс запас на
## один кадр бега (5 м/с × 1/60 с ≈ 8 см горизонтали над кромкой).
const FLOOR_SNAP_LENGTH := 0.55
## Длина луча, которым ищется пол под ногами на спуске, метров. Ровно высота
## шага: сойти игрок обязан ровно с того, на что взошёл бы, — и ни с чего выше.
## Плюс сантиметр, чтобы луч не заканчивался ровно в плоскости пола.
const FLOOR_REACH := STEP_HEIGHT + 0.01

## Ускорение из мировых осей в оси камеры: x вправо, z вперёд.
## Кружке важно не куда разогнался мир, а куда качнуло руку.
static func local_acceleration(world: Vector3, yaw_deg: float) -> Vector3:
	return world.rotated(Vector3.UP, -deg_to_rad(yaw_deg))

## input.x — вправо, input.y — вперёд, оба в диапазоне [-1, 1].
## Возвращает горизонтальное направление в мировых координатах.
static func wish_direction(input: Vector2, yaw_deg: float) -> Vector3:
	var direction := Vector3(input.x, 0.0, -input.y)
	if direction.length_squared() > 1.0:
		direction = direction.normalized()
	return direction.rotated(Vector3.UP, deg_to_rad(yaw_deg))

## Проба вперёд на один кадр: куда игрок собирается шагнуть.
##
## Считается по ЖЕЛАЕМОЙ скорости, а не по фактической, и это не мелочь.
## Упёршись в ступень, игрок теряет о неё фактическую скорость в тот же кадр:
## move_and_slide гасит составляющую вдоль нормали. Со следующего кадра разгон
## возвращает всего ACCELERATION × delta ≈ 0.23 м/с, то есть проба по факту
## схлопнулась бы с пяти сантиметров до четырёх миллиметров — подъём на одну
## ступеньку растянулся бы на сотни кадров и выглядел бы залипанием.
static func step_probe(wish: Vector3, delta: float) -> Vector3:
	var flat := Vector3(wish.x, 0.0, wish.z)
	if flat.length() < STEP_MIN_SPEED:
		return Vector3.ZERO
	return flat * delta

## Круче ли площадка предельного угла пола. Ненормированная нормаль (в том
## числе нулевая, какую возвращает непопавший луч) — это «площадки нет», и
## считается непригодной: молчаливый ноль здесь дал бы угол 0° и пропустил бы
## шаг в пустоту.
static func is_too_steep(normal: Vector3, max_floor_angle: float) -> bool:
	if not normal.is_normalized():
		return true
	return normal.angle_to(Vector3.UP) > max_floor_angle

## Решение о шаге целиком, по четырём замерам зондов. Возвращает подъём в
## метрах; 0.0 — шага нет.
##
##   blocked        — упёрлись ли, двигаясь вперёд с нынешней высоты;
##   headroom       — сколько метров свободно над головой, но не больше шага;
##   ahead_free     — свободен ли тот же путь вперёд с поднятой высоты;
##   landing_rise   — насколько выше подошвы встанет капсула, опустившись на
##                    препятствие; отрицательное — опоры не нашлось вовсе;
##   surface_rise   — насколько выше подошвы САМА площадка, снятая лучом за
##                    кромкой; она же решает, по росту ли препятствие;
##   surface_normal — нормаль этой площадки;
##   max_floor_angle— floor_max_angle тела, радианы.
##
## Функция чистая нарочно. Всё, что решает, шагать или упереться, лежит здесь и
## проверяется тестом напрямую; на долю физики остаются три test_move и один
## луч, которые ничего не решают, а только меряют.
static func step_rise(blocked: bool, headroom: float, ahead_free: bool,
		landing_rise: float, surface_rise: float, surface_normal: Vector3,
		max_floor_angle: float) -> float:
	# Шагают, только упёршись. Иначе капсулу подбрасывало бы на каждом кадре
	# ходьбы по ровному месту.
	if not blocked:
		return 0.0
	# Низкий потолок. Требуется полная высота шага, а не та, которой хватило бы
	# конкретному уступу: зонды вперёд и вниз запускаются с поднятой на полный
	# шаг капсулы, и меньшая высота сделала бы их замеры недействительными.
	if headroom < STEP_HEIGHT:
		return 0.0
	# Препятствие выше шага: с поднятой высоты путь всё равно закрыт.
	if not ahead_free:
		return 0.0
	# Ступать некуда (обрыв) либо подъём вне окна шага.
	if landing_rise <= STEP_MIN or landing_rise > STEP_HEIGHT:
		return 0.0
	# Площадка выше шага. Это отдельная проверка, а не та же самая: капсула
	# ложится на ребро и подошва встаёт НИЖЕ площадки, поэтому по одному только
	# landing_rise стена в шестьдесят сантиметров выглядит ступенью в тридцать
	# семь (см. STEP_SURFACE_AHEAD).
	if surface_rise > STEP_HEIGHT:
		return 0.0
	# Площадка круче предельного угла пола: это склон или стена, а не ступень.
	# Без этой проверки игрок взбирался бы по горе, упираясь и подпрыгивая.
	if is_too_steep(surface_normal, max_floor_angle):
		return 0.0
	return landing_rise

## Нужно ли на спуске притянуть игрока к полу вместо того, чтобы дать ему падать.
##
##   on_floor       — держит ли его физика прямо сейчас;
##   vertical_speed — velocity.y; вверх — значит игрока не притягивать;
##   was_grounded   — стоял ли он на опоре в прошлом кадре;
##   floor_gap      — сколько метров до пола под подошвой; отрицательное
##                    значение означает, что пола в пределах шага нет.
##
## Проверка «был на земле» здесь не формальность. Без неё прилипание поймало бы
## и того, кто честно падает с высоты: пролетая мимо любого выступа, он был бы
## приклеен к нему на полном ходу.
## Скорость хода с учётом воды; depth — глубина под подошвой, метров.
## На границе плавания брод и заплыв сходятся почти вровень, без рывка.
static func water_speed(dry_speed: float, depth: float, sprint: bool) -> float:
	if depth > SWIM_DEPTH:
		return SWIM_SPRINT if sprint else SWIM_SPEED
	if depth <= WADE_DEPTH:
		return dry_speed
	return dry_speed * lerpf(1.0, WADE_SLOWDOWN, (depth - WADE_DEPTH) / (SWIM_DEPTH - WADE_DEPTH))

## Вертикаль пловца: тянется к скорости всплытия на плавучую высоту, прежняя
## (скажем, прыжок в воду с берега) гаснет за шестую долю секунды.
static func buoyant_velocity(vertical: float, feet_y: float, surface: float, delta: float) -> float:
	var rise := (surface - SWIM_DEPTH - feet_y) * BUOYANCY
	return lerpf(vertical, rise, 1.0 - exp(-BUOYANCY_RESPONSE * delta))

## Скорость, к которой тянется ныряльщик. forward уже с наклоном камеры;
## vertical_input: +1 Пробел, -1 C/Ctrl.
static func dive_velocity(input: Vector2, forward: Vector3, right: Vector3,
		vertical_input: float, speed: float) -> Vector3:
	var wish := forward * input.y + right * input.x
	if wish.length_squared() > 1.0:
		wish = wish.normalized()
	var target := wish * speed + Vector3.UP * vertical_input * DIVE_SPEED
	if input == Vector2.ZERO and vertical_input == 0.0:
		target.y = DRIFT_UP
	return target

static func should_stick(on_floor: bool, vertical_speed: float,
		was_grounded: bool, floor_gap: float) -> bool:
	if on_floor or not was_grounded:
		return false
	if vertical_speed > 0.0:
		return false
	return floor_gap >= 0.0 and floor_gap <= STEP_HEIGHT
